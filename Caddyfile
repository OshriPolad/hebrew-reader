# Caddy gets and renews a free HTTPS certificate (Let's Encrypt) automatically.
{$DOMAIN} {
	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Tokens appear in audio/feed URLs: never send them to other sites
		Referrer-Policy "no-referrer"
		-Server
	}
}
