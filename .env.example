# Copy to .env and fill in. Never commit .env.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=northeurope
# Optional voice overrides
VOICE_HE=he-IL-HilaNeural
VOICE_EN=en-US-AvaNeural

# Generate each token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_TOKEN = login code for the web app (full access)
APP_TOKEN=
# FEED_TOKEN = private podcast feed (listen only). Must differ from APP_TOKEN. Optional.
FEED_TOKEN=

# Local: where the database and audio files are stored (Docker overrides this)
DATA_DIR=data

# Production only
DOMAIN=yourname.duckdns.org
PUBLIC_URL=https://yourname.duckdns.org

# Limits (defaults shown). Azure free tier = 500,000 characters/month.
MAX_CHARS=60000
MONTHLY_CHAR_QUOTA=500000
